DATABASE_URL="postgresql://USER@localhost:5432/pisconauta"
AUTH_SECRET="change-me-32-chars-min"
# Local disk for uploads in dev; swap lib/storage.ts for S3/Netlify Blobs in production.
STORAGE_DIR="./storage"
# Admin login created by the seed. If unset, the seed generates one and prints it once.
ADMIN_EMAIL="admin@pisconauta.pe"
ADMIN_PASSWORD=""
# Optional: Google Cloud Vision key for OCR label matching
VISION_API_KEY=""
# Legal identity shown on /privacidad, /terminos and /contacto
NEXT_PUBLIC_OPERATOR="FIA International"
NEXT_PUBLIC_OPERATOR_ADDRESS="Leusden, Países Bajos"
NEXT_PUBLIC_CONTACT_EMAIL="hola@pisconauta.pe"
NEXT_PUBLIC_PRIVACY_EMAIL="privacidad@pisconauta.pe"
